  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <div class="lightbox-close" id="lightboxClose">×</div>
    <div class="lightbox-nav prev" id="lightboxPrev">‹</div>
    <div class="lightbox-nav next" id="lightboxNext">›</div>
    <div class="lightbox-content">
      <img class="lightbox-image" id="lightboxImage" src="" alt="" />
      <div class="lightbox-counter" id="lightboxCounter"></div>
    </div>
  </div>

  <script define:vars={{ entryId: entry.data.id, images: entry.data.images }}>
    document.addEventListener('DOMContentLoaded', () => {
      // Gallery functionality for all elements
      const thumbnailItems = document.querySelectorAll('.thumbnail-item');
      const mainImages = document.querySelectorAll('.main-image');
      
      if (thumbnailItems.length > 0 && mainImages.length > 0) {
        // 最初のサムネイルをアクティブにする
        if (thumbnailItems.length > 0) {
          thumbnailItems[0].classList.add('active');
        }
        
        function switchImage(index) {
          // サムネイルのアクティブ状態を更新
          thumbnailItems.forEach((item, i) => {
            if (i === index) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
          
          // メイン画像のアクティブ状態を更新
          mainImages.forEach((img, i) => {
            if (i === index) {
              img.classList.add('active');
            } else {
              img.classList.remove('active');
            }
          });
        }
        
        // サムネイルクリックイベント
        thumbnailItems.forEach((item, index) => {
          item.addEventListener('click', () => {
            switchImage(index);
          });
        });
      } else {
        // 通常のLightbox機能（ギャラリーがない場合）
        const imageGallery = document.getElementById('imageGallery');
        const lightbox = document.getElementById('lightbox');
        const lightboxImage = document.getElementById('lightboxImage');
        const lightboxClose = document.getElementById('lightboxClose');
        const lightboxPrev = document.getElementById('lightboxPrev');
        const lightboxNext = document.getElementById('lightboxNext');
        const lightboxCounter = document.getElementById('lightboxCounter');
        
        let currentIndex = 0;

        function openLightbox(index) {
          currentIndex = index;
          updateLightbox();
          lightbox.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          lightbox.classList.remove('is-active');
          document.body.style.overflow = '';
        }

        function updateLightbox() {
          if (images.length === 0) return;
          lightboxImage.src = images[currentIndex];
          lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
        }

        function showNext() {
          currentIndex = (currentIndex + 1) % images.length;
          updateLightbox();
        }

        function showPrev() {
          currentIndex = (currentIndex - 1 + images.length) % images.length;
          updateLightbox();
        }

        // 画像クリックでLightboxを開く
        imageGallery?.querySelectorAll('.image-wrap').forEach((wrap, index) => {
          wrap.addEventListener('click', () => openLightbox(index));
        });

        // Lightboxコントロール
        lightboxClose?.addEventListener('click', closeLightbox);
        lightboxNext?.addEventListener('click', showNext);
        lightboxPrev?.addEventListener('click', showPrev);

        // 背景クリックで閉じる
        lightbox?.addEventListener('click', (e) => {
          if (e.target === lightbox) closeLightbox();
        });

        // キーボード操作
        document.addEventListener('keydown', (e) => {
          if (!lightbox.classList.contains('is-active')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowRight') showNext();
          if (e.key === 'ArrowLeft') showPrev();
        });
      }
    });
  </script>
</Layout>