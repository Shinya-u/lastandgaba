---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';

const entries = await getCollection('essay');

// 表示順をID昇順にしたい場合（任意）
entries.sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<Layout title="ESSAY | LAST &amp; GABA">
  <style>
    main { padding: 60px 5vw; max-width: 1200px; margin: 0 auto; }
    .page-title { font-family: var(--font-serif); font-size: 0.9rem; letter-spacing: 0.4em; color: var(--accent); margin-bottom: 60px; text-align: center; }

    .essay-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 60px 40px; }
    .essay-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: opacity 0.3s; }
    .essay-card:hover { opacity: 0.7; }
    .image-wrapper { width: 100%; aspect-ratio: 16 / 9; background-color: #eee; overflow: hidden; margin-bottom: 15px; }
    .image-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .essay-info { font-family: var(--font-serif); }
    .essay-date { font-size: 0.7rem; color: var(--accent); letter-spacing: 0.1em; margin-bottom: 4px; text-transform: uppercase; }
    .essay-title { font-size: 0.9rem; letter-spacing: 0.15em; font-weight: bold; }
    @media (max-width: 768px) { .essay-grid { grid-template-columns: repeat(1, 1fr); gap: 40px 20px; } }
  </style>
  
  <Breadcrumb items={[
    { label: 'HOME', href: '/' },
    { label: 'ESSAY' }
  ]} />
  
  <main>
      <h1 class="page-title">03 ESSAY</h1>

      <div class="essay-grid">
        {entries.map((entry) => (
          <a href={`/essay/${entry.data.id}`} class="essay-card">
            <div class="image-wrapper">
              <img src={entry.data.thumbnail} alt={entry.data.title} loading="lazy" />
            </div>
            <div class="essay-info">
              <div class="essay-date">{entry.data.date}</div>
              {entry.data.id !== 'es-0003' && <div class="essay-title">{entry.data.title}</div>}
            </div>
          </a>
        ))}
      </div>
  </main>
</Layout>