---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const entries = await getCollection('essay');
  return entries.map((entry) => ({
    params: { id: entry.data.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// Markdown本文をHTMLとしてレンダリングするためのコンポーネント
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | ESSAY`}>
  <style>
    main { padding: 40px 5vw; max-width: 800px; margin: 0 auto; }
    .date { font-size: 0.9rem; letter-spacing: 0.2em; color: var(--accent); }
    .title { font-family: var(--font-serif); font-size: 2rem; margin: 10px 0 32px; }

    .single-image { width: 100%; aspect-ratio: 16 / 9; background: #eee; overflow: hidden; margin-bottom: 32px; }
    .single-image img { width: 100%; height: 100%; object-fit: cover; }

    /* Gallery styles */
    .gallery-container { display: flex; gap: 20px; margin: 0 0 32px; }
    .thumbnail-list { display: flex; flex-direction: column; gap: 12px; width: 100px; }
    .thumbnail-item { width: 100%; aspect-ratio: 3 / 4; background: #111; overflow: hidden; cursor: pointer; transition: all 0.3s; opacity: 0.5; border: 2px solid transparent; }
    .thumbnail-item:hover { opacity: 0.8; }
    .thumbnail-item.active { opacity: 1; border-color: #fff; }
    .thumbnail-item img { width: 100%; height: 100%; object-fit: contain; }
    .main-image-container { flex: 1; position: relative; aspect-ratio: 3 / 4; background: #111; overflow: hidden; }
    .main-image { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s ease-in-out; }
    .main-image.active { opacity: 1; }
    .main-image img { width: 100%; height: 100%; object-fit: contain; }

    @media (max-width: 768px) {
      .gallery-container { flex-direction: column; }
      .thumbnail-list { flex-direction: row; width: 100%; overflow-x: auto; }
      .thumbnail-item { min-width: 80px; }
    }

    .body { font-family: var(--font-serif); line-height: 2; font-size: 0.95rem; color: #444; }
    .body p { margin: 0 0 1.2em; }
    .body a { color: inherit; text-decoration: underline; }
    .body h2, .body h3 { font-family: var(--font-serif); margin: 2em 0 0.8em; }
    .body table { width: 100%; border-collapse: collapse; margin: 1.6em 0; }
    .body th, .body td { border: 1px solid #ccc; padding: 0.6em 0.8em; text-align: left; vertical-align: top; }
    .body th { background: #f7f7f7; font-weight: 600; }
  </style>
  
  <Breadcrumb items={[
    { label: 'HOME', href: '/' },
    { label: 'ESSAY', href: '/essay' },
    ...(entry.data.id !== 'es-0003' ? [{ label: entry.data.title }] : [])
  ]} />
  
  <main>
      <div class="date">{entry.data.date}</div>
      {entry.data.id !== 'es-0003' && <h1 class="title">{entry.data.title}</h1>}

      {/* Gallery for multiple images */}
      {entry.data.images && entry.data.images.length > 0 && (
        <div class="gallery-container">
          <div class="thumbnail-list" id="thumbnailList">
            {entry.data.images.map((img, index) => (
              <div 
                class={`thumbnail-item ${index === 0 ? 'active' : ''}`}
                data-index={index}
              >
                <img src={img} alt={`Thumbnail ${index + 1}`} loading="lazy" />
              </div>
            ))}
          </div>
          <div class="main-image-container">
            {entry.data.images.map((img, index) => (
              <div 
                class={`main-image ${index === 0 ? 'active' : ''}`}
                data-index={index}
              >
                <img src={img} alt={`${entry.data.title} ${index + 1}`} loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Fallback for single image */}
      {(!entry.data.images || entry.data.images.length === 0) && entry.data.image && (
        <div class="single-image">
          <img src={entry.data.image} alt={entry.data.title} loading="lazy" />
        </div>
      )}

      <div class="body">
        <Content />
      </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const thumbnails = document.querySelectorAll('.thumbnail-item');
      const images = document.querySelectorAll('.main-image');

      if (thumbnails.length > 0 && images.length > 0) {
        // 最初のサムネイルをアクティブにする
        if (thumbnails.length > 0) {
          thumbnails[0].classList.add('active');
        }
        
        function switchImage(index: number) {
          // サムネイルのアクティブ状態を更新
          thumbnails.forEach((item, i) => {
            if (i === index) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
          
          // メイン画像のアクティブ状態を更新
          images.forEach((img, i) => {
            if (i === index) {
              img.classList.add('active');
            } else {
              img.classList.remove('active');
            }
          });
        }
        
        // サムネイルクリックイベント
        thumbnails.forEach((item, index) => {
          item.addEventListener('click', () => {
            switchImage(index);
          });
        });
      }
    });
  </script>
</Layout>